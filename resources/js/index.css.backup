:root {
  font-family: Helvetica, Arial, sans-serif;
  color: #302d47;
  background: #ffffff;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
}

button,
input,
textarea,
select {
  font: inherit;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 3px solid #aa9af8;
  outline-offset: 3px;
}

::selection {
  color: #302d47;
  background: #e8e0ff;
}


/* NoteNest authentication */

.auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #f5f6fb;
}

.auth-card {
    width: 100%;
    max-width: 440px;
    padding: 36px;
    background: #ffffff;
    border: 1px solid #e8eaf2;
    border-radius: 20px;
    box-shadow: 0 16px 48px rgba(30, 41, 59, 0.08);
}

.auth-brand {
    text-align: center;
    margin-bottom: 32px;
}

.auth-brand-mark {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    border-radius: 16px;
    background: #4f46e5;
    color: white;
    font-size: 26px;
    font-weight: 700;
}

.auth-brand h1 {
    margin: 0;
    color: #171923;
    font-size: 28px;
    font-weight: 700;
}

.auth-brand p,
.auth-heading p {
    color: #73788a;
    margin: 8px 0 0;
}

.auth-heading {
    margin-bottom: 24px;
}

.auth-heading h2 {
    margin: 0;
    color: #171923;
    font-size: 23px;
}

.auth-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.auth-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.auth-field label {
    color: #343849;
    font-size: 14px;
    font-weight: 600;
}

.auth-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1px solid #dfe2eb;
    border-radius: 10px;
    outline: none;
    background: #ffffff;
    color: #171923;
    font: inherit;
}

.auth-field input:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

.auth-submit-button {
    width: 100%;
    padding: 13px 16px;
    border: 0;
    border-radius: 10px;
    background: #4f46e5;
    color: #ffffff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
}

.auth-submit-button:hover {
    background: #4338ca;
}

.auth-submit-button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
}

.auth-switch {
    margin-top: 24px;
    text-align: center;
    color: #73788a;
    font-size: 14px;
}

.auth-switch button {
    padding: 0;
    border: 0;
    background: transparent;
    color: #4f46e5;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
}

.auth-error,
.auth-field-error,
.auth-session-error {
    color: #b42318;
    font-size: 13px;
}

.auth-error {
    padding: 12px;
    margin-bottom: 16px;
    border-radius: 8px;
    background: #fef3f2;
}

.auth-field-error {
    margin: 0;
}

.auth-loading {
    min-height: 100vh;
    display: grid;
    place-items: center;
    color: #73788a;
}

.auth-session-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    padding: 10px 24px;
    background: #ffffff;
    border-bottom: 1px solid #e8eaf2;
    color: #343849;
    font-size: 14px;
}

.auth-logout-button {
    padding: 7px 12px;
    border: 1px solid #dfe2eb;
    border-radius: 8px;
    background: #ffffff;
    color: #343849;
    font: inherit;
    cursor: pointer;
}

.auth-logout-button:hover {
    background: #f5f6fb;
}

.auth-session-error {
    padding: 8px 24px;
    background: #fef3f2;
}

@media (max-width: 480px) {
    .auth-card {
        padding: 26px 20px;
    }

    .auth-session-bar {
        padding: 10px 14px;
    }
}
